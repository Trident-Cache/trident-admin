{
  "name": "@trident-cache/sdk",
  "version": "1.8.0",
  "description": "Official Node.js/TypeScript SDK for Trident HTTP Cache: the admin API client, and (@trident-cache/sdk/delivery) the integration contract for durable purges",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "import": "./dist/delivery/index.mjs",
      "require": "./dist/delivery/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/delivery/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/delivery/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "trident",
    "cache",
    "http-cache",
    "cdn",
    "purge",
    "varnish",
    "reverse-proxy",
    "edge-cache"
  ],
  "author": "qoliber <info@qoliber.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qoliber/trident"
  },
  "homepage": "https://trident-cache.dev",
  "bugs": {
    "url": "https://github.com/qoliber/trident/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
